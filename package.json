{
  "name": "landloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "start": "tsx server/index.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && biome check .",
    "fix": "biome check . --write .",
    "test": "tsx --test tests/*.test.ts && node --test .github/scripts/*.test.mjs",
    "test:e2e": "tsx tests/browser.ts",
    "test:e2e:ci": "playwright test",
    "test:e2e:cache": "tsx tests/browser-cache.ts",
    "test:e2e:shared-cache": "tsx tests/browser-shared-cache.ts",
    "test:e2e:history": "tsx tests/browser-history.ts",
    "cf:types": "wrangler types",
    "cf:dev": "npm run build && wrangler dev --port 8790",
    "deploy": "npm run build && wrangler deploy",
    "prelint": "npm run cf:types",
    "prebuild": "npm run cf:types",
    "test:e2e:point-history": "tsx tests/browser-point-history.ts",
    "test:e2e:map-ui": "tsx tests/browser-map-ui.ts",
    "test:e2e:land-prices": "tsx tests/browser-land-prices.ts",
    "test:e2e:transactions": "tsx tests/browser-transactions.ts",
    "test:e2e:transaction-comparison": "tsx tests/browser-transaction-comparison.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
